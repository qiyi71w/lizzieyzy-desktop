{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LizzieYzy Tauri",
  "mainBinaryName": "lizzieyzy-tauri",
  "version": "0.1.0",
  "identifier": "io.github.qiyi71w.lizzieyzy-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LizzieYzy Tauri",
        "width": 1500,
        "height": 900,
        "minWidth": 520,
        "minHeight": 400,
        "resizable": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
